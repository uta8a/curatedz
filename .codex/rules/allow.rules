# 読み取り用途に限定する。ブランチ操作・コミット・リモート更新は含めない。
prefix_rule(
    pattern = ["git", ["status", "diff", "log", "show", "rev-parse", "ls-files"]],
    decision = "allow",
    justification = "ローカルの差分と履歴を確認する",
    match = ["git status --short", "git diff --check", "git ls-files"],
    not_match = ["git branch -D work", "git commit -m test", "git push origin main"],
)

prefix_rule(
    pattern = ["rg"],
    decision = "allow",
    justification = "ローカルファイルを検索する",
    match = ["rg --files --hidden", "rg -n document_id docs"],
    not_match = ["git status"],
)

prefix_rule(
    pattern = ["gh", "repo", "view"],
    decision = "allow",
    justification = "リポジトリの情報を確認する",
    match = ["gh repo view uta8a/curatedz"],
    not_match = ["gh repo delete uta8a/curatedz"],
)

prefix_rule(
    pattern = ["gh", "pr", ["view", "list", "checks"]],
    decision = "allow",
    justification = "PRとCIの結果を確認する",
    match = ["gh pr view 1", "gh pr list", "gh pr checks 1"],
    not_match = ["gh pr create --draft", "gh pr merge 1"],
)

prefix_rule(
    pattern = ["gh", "issue", ["list", "view"]],
    decision = "allow",
    justification = "Issueを確認する",
    match = ["gh issue list", "gh issue view 1"],
    not_match = ["gh issue create --title test", "gh issue edit 1"],
)

prefix_rule(
    pattern = ["gh", "run", ["list", "view"]],
    decision = "allow",
    justification = "CIの実行履歴とログを確認する",
    match = ["gh run list", "gh run view 123 --log-failed"],
    not_match = ["gh run rerun 123"],
)
