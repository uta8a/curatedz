# システム全体に影響する操作を禁止する。
# 通常のファイル編集やGitHub操作は、実行環境とユーザーの依頼に従う。
prefix_rule(
    pattern = [["dd", "mkfs", "shutdown", "reboot", "sudo", "su"]],
    decision = "forbidden",
    justification = "システム・ディスク操作や権限昇格は開発作業の対象外",
    match = ["dd if=/dev/zero of=/dev/example", "sudo reboot", "shutdown -h now"],
    not_match = ["git status", "git push origin codex/example", "gh pr create --draft"],
)
